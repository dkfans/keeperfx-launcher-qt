msgctxt "UpdateDialog|Appended to version string"
msgid "Alpha"
msgstr "Alfa"

msgctxt "UpdateDialog|Label"
msgid "Current version:"
msgstr "Aktuální verze:"

msgctxt "UpdateDialog|Label"
msgid "New version:"
msgstr "Nová verze:"

msgctxt "UpdateDialog|Progress bar"
msgid "Downloading: %p% (%vMiB)"
msgstr "Stahování: %p% (%vMiB)"

msgctxt "UpdateDialog|MessageBox Title"
msgid "Update failed"
msgstr "Aktualizace se nezdařila"

msgctxt "UpdateDialog|Failure Message"
msgid ""
"It seems the launcher does not have permission to write files in the "
"application directory."
msgstr "Zdá se, že launcher nemá oprávnění zapisovat soubory do adresáře aplikace."

msgctxt "UpdateDialog|Failure Message"
msgid "You might have to start the launcher with administrator rights."
msgstr "Možná bude nutné spustit launcher s oprávněními správce."

msgctxt "UpdateDialog|Failure Message"
msgid ""
"It seems that KeeperFX is currently running. The updater cannot replace the "
"game files while it is open.\n"
"\n"
"Please close KeeperFX before trying again.\n"
"\n"
"If the issue persists, restart your PC and retry the update."
msgstr "Zdá se, že KeeperFX právě běží. Aktualizační nástroj nemůže nahradit soubory hry, dokud je spuštěná.\n\nPřed dalším pokusem prosím ukončete KeeperFX.\n\nPokud problém přetrvává, restartujte počítač a zkuste aktualizaci znovu."

msgctxt "UpdateDialog|Failure Message"
msgid ""
"It seems that the legacy KeeperFX launcher is currently running.\n"
"\n"
"Please close it before trying again.\n"
"\n"
"If the issue persists, restart your PC and retry the update."
msgstr "Zdá se, že starý launcher KeeperFX právě běží.\n\nPřed dalším pokusem ho prosím ukončete.\n\nPokud problém přetrvává, restartujte počítač a zkuste aktualizaci znovu."

msgctxt "UpdateDialog|Failure Message"
msgid ""
"The updater failed to grab the latest stable version which is required for "
"this alpha."
msgstr "Aktualizačnímu nástroji se nepodařilo získat nejnovější stabilní verzi, kterou tato alfa verze vyžaduje."

msgctxt "UpdateDialog|Title label"
msgid "Updating..."
msgstr "Aktualizace..."

msgctxt "UpdateDialog|Progress bar (%p=percentage)"
msgid "Comparing: %p%"
msgstr "Porovnávání: %p%"

#, qt-format
msgctxt "UpdateDialog|Failure Message"
msgid "Failed to open file: %1"
msgstr "Nepodařilo se otevřít soubor: %1"

msgctxt "UpdateDialog|Failure Message"
msgid "Archive download failed."
msgstr "Stažení archivu se nezdařilo."

msgctxt "UpdateDialog|Progress bar"
msgid "Extracting: %p%"
msgstr "Rozbalování: %p%"

msgctxt "UpdateDialog|Title label"
msgid "Update complete!"
msgstr "Aktualizace dokončena!"

#, qt-format
msgctxt "UpdateDialog|MessageBox Text"
msgid "KeeperFX has been successfully updated to version %1!"
msgstr "KeeperFX byl úspěšně aktualizován na verzi %1!"

msgctxt "UpdateDialog|MessageBox Title"
msgid "Confirmation"
msgstr "Potvrzení"

msgctxt "UpdateDialog|MessageBox Text"
msgid "Are you sure you want to cancel the update?"
msgstr "Opravdu chcete zrušit aktualizaci?"

msgctxt "UpdateDialog|Failure message"
msgid "Failed to create temp directory"
msgstr "Nepodařilo se vytvořit dočasný adresář"

msgctxt "UpdateDialog|Progress bar"
msgid "Downloading: %p%"
msgstr "Stahování: %p%"

msgctxt "UpdateDialog|Failure Message"
msgid "The temporary directory does not exist"
msgstr "Dočasný adresář neexistuje"

msgctxt "UpdateDialog|Progress bar"
msgid "Copying: %p%"
msgstr "Kopírování: %p%"

#, qt-format
msgctxt "UpdateDialog|Failure Message"
msgid "File does not exist: %1"
msgstr "Soubor neexistuje: %1"

#, qt-format
msgctxt "UpdateDialog|Failure Message"
msgid "Failed to create destination directory: %1"
msgstr "Nepodařilo se vytvořit cílový adresář: %1"

#, qt-format
msgctxt "UpdateDialog|Failure Message"
msgid "Failed to remove file (%1): %2"
msgstr "Nepodařilo se odstranit soubor (%1): %2"

#, qt-format
msgctxt "UpdateDialog|Failure Message"
msgid "Failed to move file (%1): %2"
msgstr "Nepodařilo se přesunout soubor (%1): %2"

msgctxt "UpdateDialog|Failure Message"
msgid ""
"It is possible an antivirus is causing this problem. Try disabling it and "
"try again."
msgstr "Tento problém může způsobovat antivirový program. Zkuste jej vypnout a akci zopakovat."

msgctxt "UpdateDialog|Failure message"
msgid "Failed to move all downloaded files"
msgstr "Nepodařilo se přesunout všechny stažené soubory"

msgctxt "main|MessageBox Title"
msgid "KeeperFX Error"
msgstr "Chyba KeeperFX"

msgctxt "main|MessageBox Text"
msgid ""
"Failed to determine the KeeperFX version. This is required to submit a crash "
"report."
msgstr "Nepodařilo se zjistit verzi KeeperFX. Tato informace je nutná k odeslání hlášení o pádu."
